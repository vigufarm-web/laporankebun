{
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__p=:path*" }],
  "functions": {
    "api/index.js": { "includeFiles": "{lib/**,public/js/**}", "maxDuration": 60 }
  },
  "headers": [
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
