{
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily/cleanup",
      "schedule": "0 17 * * *"
    }
  ],
  "regions": [
    "sin1"
  ],
  "redirects": [
    {
      "source": "/peta",
      "destination": "https://vigufarm-web.github.io/peta-kebun/",
      "permanent": false
    },
    {
      "source": "/peta/",
      "destination": "https://vigufarm-web.github.io/peta-kebun/",
      "permanent": false
    },
    {
      "source": "/peta.html",
      "destination": "https://vigufarm-web.github.io/peta-kebun/",
      "permanent": false
    }
  ]
}
